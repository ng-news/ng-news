# ng-news — environment for the Vercel functions (submissions)
# Copy to .env for local `vercel dev`, or set in the Vercel dashboard for deploys.

# Turso database (dashboard -> your database -> connection string)
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-1234567.eu-central-1.aws.data.turso.io
TURSO_AUTH_TOKEN=YOUR-TURSO-AUTH-TOKEN

# Token required for /admin (any long random string; sent as x-admin-token header)
ADMIN_TOKEN=change-me-to-a-long-random-string
